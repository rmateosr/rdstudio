# Windows shell scripts need CRLF, or cmd.exe mis-parses them and yields
# bizarre "'ild' is not recognized" errors. Force CRLF on disk for these
# regardless of the contributor's git config / OS.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Everything else: keep the working-tree style, but normalize to LF on commit.
* text=auto
